# 環境與快取（每台自己建，⛔ 不進 repo）
.venv/
__pycache__/
*.pyc

# 實驗產物（留在 compute node 的 /archive，⛔ 不進 repo）
outputs/
runs/
wandb/
*.log

# checkpoint：只放行已經證明有用的 value（2.1M），其餘一律擋
checkpoints/*
!checkpoints/scratch_value.pt

# rollout / probe 的產物：JSON 很小又是結論本身，留著進 repo；
# checkpoint 是 GB 級的中間物，⛔ 不進 repo（要重現用 slurm/ 底下的腳本重跑）
results/*.pt
# 2026-10-02 補：上一條只擋頂層，子目錄的 checkpoint 同一個政策（results/day_0904/fsq、night_0903/fsq 的 6 個 .pt 照此不進庫、原地不動）
results/**/*.pt
slurm_outputs/

# 2026-10-02 untracked 分流 gitignore 桶（relay-maiden bucket-list G1-G6，主持人裁示「按清單執行」）
# 可再生的日誌／暫存／smoke 產物／本機參考快照，⛔ 不進 repo（檔案原地不動，只是不再被追蹤）
# G1 排程器 .out 傾倒區（歷史上從未進庫）
/slurm/logs/
# G2 repo 根目錄的排程器 stdout（j_signal_<jobid>_<idx>.out，根目錄 .out 歷史上從未進庫）
/j_signal_*.out
# G3 檔名標示暫存的 slurm 腳本
/slurm/*_tmp.sh
# G4 smoke 測試產物目錄（含 GB 級 .pt；依名稱視為可重跑再生，未逐一驗證）
/results/smoke_*/
# G5 執行期 jsonl 日誌（divlog 家族）
/results/divlog_*.jsonl
# G6 本機參考／暫存快照
/.smokeref/
